# Enable "Safe Browsing APIs" in your Google Cloud project, then add its API key.
# Copy this file to .env. Never commit .env or paste the key into reports.
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: generate an API key in Google AI Studio for on-demand explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REPORT_MODEL=gemini-3.5-flash-lite

# Supabase Auth + per-user investigation storage. No service-role key is needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Gmail inbox protection. Create a Web OAuth client and enable the Gmail API.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/email/gmail/callback
