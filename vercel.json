{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app"
    },
    "webassure": {
      "root": "webassure",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "webassure" } }
  ]
}
